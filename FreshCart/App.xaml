<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FreshCart"
             xmlns:converters="clr-namespace:FreshCart.Converters"
             x:Class="FreshCart.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Force Light Theme Colors -->
            <Color x:Key="PrimaryColor">#4CAF50</Color>
            <Color x:Key="SecondaryColor">#2196F3</Color>
            <Color x:Key="BackgroundColor">#F5F5F5</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#333333</Color>
            <Color x:Key="TextSecondaryColor">#666666</Color>
            <Color x:Key="TextMutedColor">#999999</Color>
            <Color x:Key="ErrorColor">#F44336</Color>
            <Color x:Key="SuccessColor">#4CAF50</Color>
            <Color x:Key="WarningColor">#FF9800</Color>

            <!-- Converters -->
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:StatusStepConverter x:Key="StatusStepConverter" />
            <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- Global Styles -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}"/>
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}"/>
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
            </Style>

            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}"/>
            </Style>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>