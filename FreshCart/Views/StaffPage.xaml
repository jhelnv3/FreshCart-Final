<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FreshCart.ViewModels"
             xmlns:models="clr-namespace:FreshCart.Models"
             x:Class="FreshCart.Views.StaffPage"
             Title="Staff Dashboard"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <viewmodels:StaffViewModel/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header with Title and Logout -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10,8" BackgroundColor="White">
            <Label Grid.Column="0" Text="Staff Dashboard" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" TextColor="#333333"/>
            <Button Grid.Column="1" Text="🚪" Command="{Binding LogoutCommand}"
                    BackgroundColor="#F44336" TextColor="White" CornerRadius="18"
                    HeightRequest="36" WidthRequest="50" FontSize="16" Padding="0"/>
        </Grid>

        <!-- Tab Buttons -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    BackgroundColor="White" Padding="5">
            <HorizontalStackLayout Spacing="5" Padding="5">
                <Button x:Name="OrdersTab" Text="📦 Orders" Clicked="OnOrdersTabClicked"
                        BackgroundColor="#2196F3" TextColor="White" CornerRadius="18"
                        HeightRequest="36" FontSize="12" Padding="12,0" MinimumWidthRequest="85"/>
                <Button x:Name="AddProductTab" Text="➕ Add" Clicked="OnAddProductTabClicked"
                        BackgroundColor="#757575" TextColor="White" CornerRadius="18"
                        HeightRequest="36" FontSize="12" Padding="12,0" MinimumWidthRequest="70"/>
                <Button x:Name="UpdateTab" Text="📦 Products" Clicked="OnUpdateTabClicked"
                        BackgroundColor="#757575" TextColor="White" CornerRadius="18"
                        HeightRequest="36" FontSize="12" Padding="12,0" MinimumWidthRequest="90"/>
                <Button x:Name="CategoryTab" Text="🏷️ Categories" Clicked="OnCategoryTabClicked"
                        BackgroundColor="#757575" TextColor="White" CornerRadius="18"
                        HeightRequest="36" FontSize="12" Padding="12,0" MinimumWidthRequest="95"/>
                <Button x:Name="SummaryTab" Text="📊 Summary" Clicked="OnSummaryTabClicked"
                        BackgroundColor="#757575" TextColor="White" CornerRadius="18"
                        HeightRequest="36" FontSize="12" Padding="12,0" MinimumWidthRequest="85"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Content Area -->
        <Grid Grid.Row="2" x:Name="ContentArea">

            <!-- 1. Orders Content -->
            <Grid x:Name="OrdersContent" IsVisible="True">
                <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None" Margin="5,0">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                            <Label Text="📭" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="No Orders Yet" FontSize="20" FontAttributes="Bold"
                                   TextColor="#333333" HorizontalOptions="Center" Margin="0,10,0,5"/>
                            <Label Text="Customer orders will appear here once they make a purchase." 
                                   FontSize="14" TextColor="#999999" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="15,10">
                            <Label Text="Customer Orders" FontSize="20" FontAttributes="Bold"
                                   HorizontalOptions="Center" TextColor="#333333"/>
                            <Label Text="{Binding Orders.Count, StringFormat='Total Orders: {0}'}" 
                                   FontSize="13" TextColor="#666666" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Frame Margin="5,4" Padding="12" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding OrderNumber, StringFormat='📦 {0}'}" FontSize="16" FontAttributes="Bold" TextColor="#333333"/>
                                            <Label Text="{Binding OrderDate, StringFormat='📅 {0:MMM dd, yyyy hh:mm tt}'}" FontSize="11" TextColor="#666666"/>
                                        </VerticalStackLayout>
                                        <Frame Grid.Column="1" CornerRadius="12" Padding="8,4"
                                               BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               HasShadow="False" VerticalOptions="Start">
                                            <Label Text="{Binding Status}" TextColor="White" FontAttributes="Bold" FontSize="11"/>
                                        </Frame>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding PaymentMethod, StringFormat='💳 {0}'}" FontSize="12" TextColor="#666666"/>
                                        <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₱{0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="#4CAF50"/>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#E0E0E0"/>
                                    <Label Text="📋 Products:" FontSize="13" FontAttributes="Bold" TextColor="#333333"/>
                                    <Frame BackgroundColor="#F8F9FA" CornerRadius="8" Padding="8" HasShadow="False">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="5">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:CartItem">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                        <Label Grid.Column="0" Text="•" FontSize="14" VerticalOptions="Center" TextColor="#666666"/>
                                                        <Label Grid.Column="1" Text="{Binding Product.Name}" FontSize="13" VerticalOptions="Center" TextColor="#333333" LineBreakMode="TailTruncation"/>
                                                        <Frame Grid.Column="2" BackgroundColor="#E3F2FD" CornerRadius="3" Padding="6,2" HasShadow="False">
                                                            <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" TextColor="#1976D2" FontAttributes="Bold"/>
                                                        </Frame>
                                                        <Label Grid.Column="3" Text="{Binding TotalPrice, StringFormat='₱{0:F2}'}" FontSize="13" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Button Text="Update Status" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StaffViewModel}}, Path=UpdateStatusCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#2196F3" TextColor="White" CornerRadius="8" HeightRequest="36" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- 2. Add Product Content -->
            <ScrollView x:Name="AddProductContent" IsVisible="False">
                <VerticalStackLayout Padding="15" Spacing="12">
                    <Label Text="Add New Product" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
                    <Frame Padding="15" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Product Name" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                            <Entry Text="{Binding NewProductName}" Placeholder="Enter product name" TextColor="#333333" PlaceholderColor="#999999"/>
                            <Label Text="Category" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding NewProductCategory}" 
                                    Title="Tap to select category" TextColor="#333333" TitleColor="#999999"/>
                            <Label Text="Price" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                            <Entry Text="{Binding NewProductPrice}" Placeholder="Enter price (e.g., 5.99)" Keyboard="Numeric" TextColor="#333333" PlaceholderColor="#999999"/>
                            <Label Text="Stock Quantity" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                            <Entry Text="{Binding NewProductStock}" Placeholder="Enter stock quantity" Keyboard="Numeric" TextColor="#333333" PlaceholderColor="#999999"/>
                            <Button Text="Add Product" Command="{Binding AddProductCommand}" BackgroundColor="#4CAF50" TextColor="White" FontSize="15" HeightRequest="40" CornerRadius="20"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 3. Products/Update Content (Combined) -->
            <Grid x:Name="UpdateContent" IsVisible="False" RowDefinitions="Auto,*">
                <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="8">
                    <Label Text="Product Management" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>

                    <!-- View/Update Product Count -->
                    <Label Text="{Binding FilteredProducts.Count, StringFormat='Showing {0} product(s)'}" 
                           FontSize="12" TextColor="#666666" HorizontalOptions="Center"/>

                    <SearchBar Text="{Binding SearchQuery}" Placeholder="🔍 Search by name, ID, or price..." 
                              SearchCommand="{Binding SearchCommand}"
                              TextColor="#333333" PlaceholderColor="#999999" BackgroundColor="White"/>

                    <!-- Category Filter - Same design as User -->
                    <Frame BackgroundColor="White" CornerRadius="8" Padding="12,10" HasShadow="True" BorderColor="#E0E0E0">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Filter by category" FontSize="12" FontAttributes="Bold" TextColor="#666666"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="🏷️" FontSize="16" VerticalOptions="Center"/>
                                <Picker Grid.Column="1" ItemsSource="{Binding Categories}" 
                                        SelectedItem="{Binding SelectedCategory}"
                                        Title="Tap to filter by category"
                                        TextColor="#333333" TitleColor="#999999"
                                        VerticalOptions="Center" FontSize="14"/>
                                <Button Grid.Column="2" Text="✕" Command="{Binding ClearFilterCommand}"
                                        BackgroundColor="Transparent" TextColor="#999999"
                                        FontSize="14" WidthRequest="30" HeightRequest="30" Padding="0"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Table Header -->
                    <Frame BackgroundColor="#2196F3" CornerRadius="5" Padding="8" HasShadow="False">
                        <Grid ColumnDefinitions="35,*,55,55,45,45" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="ID" TextColor="White" FontAttributes="Bold" FontSize="10"/>
                            <Label Grid.Column="1" Text="Name/Cat" TextColor="White" FontAttributes="Bold" FontSize="10"/>
                            <Label Grid.Column="2" Text="Price" TextColor="White" FontAttributes="Bold" FontSize="10" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="3" Text="Stock" TextColor="White" FontAttributes="Bold" FontSize="10" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="4" Text="Edit" TextColor="White" FontAttributes="Bold" FontSize="10" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="5" Text="Del" TextColor="White" FontAttributes="Bold" FontSize="10" HorizontalTextAlignment="Center"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding FilteredProducts}" SelectionMode="None" Margin="5,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Frame Margin="5,2" Padding="6" CornerRadius="5" HasShadow="True" BackgroundColor="White">
                                <Grid ColumnDefinitions="35,*,55,55,45,45" ColumnSpacing="2">
                                    <Label Grid.Column="0" Text="{Binding Id}" VerticalOptions="Center" TextColor="#666666" FontSize="10"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold" TextColor="#333333" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Category, StringFormat='🏷️ {0}'}" FontSize="9" TextColor="#9C27B0" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <Frame Grid.Column="2" BackgroundColor="#E8F5E9" CornerRadius="3" Padding="3,2" HasShadow="False" VerticalOptions="Center">
                                        <Label Text="{Binding Price, StringFormat='₱{0:F2}'}" TextColor="#4CAF50" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center"/>
                                    </Frame>
                                    <Frame Grid.Column="3" BackgroundColor="#FFF3E0" CornerRadius="3" Padding="3,2" HasShadow="False" VerticalOptions="Center">
                                        <Label Text="{Binding StockQuantity}" TextColor="#FF9800" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center"/>
                                    </Frame>
                                    <Button Grid.Column="4" Text="✏️" BackgroundColor="#FF9800" TextColor="White"
                                            CornerRadius="3" HeightRequest="28" WidthRequest="32" Padding="0" FontSize="11"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StaffViewModel}}, Path=SelectProductForUpdateCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="5" Text="🗑️" BackgroundColor="#F44336" TextColor="White"
                                            CornerRadius="3" HeightRequest="28" WidthRequest="32" Padding="0" FontSize="11"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StaffViewModel}}, Path=DeleteProductCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                            <Label Text="🔍" FontSize="50" HorizontalOptions="Center"/>
                            <Label Text="No products found" FontSize="16" TextColor="#999999" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!-- 4. Category Management Content -->
            <Grid x:Name="CategoryContent" IsVisible="False" RowDefinitions="Auto,*">
                <VerticalStackLayout Grid.Row="0" Padding="15" Spacing="10">
                    <Label Text="Category Management" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
                    <Frame Padding="15" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0" Text="{Binding NewCategoryName}" Placeholder="Enter new category name" TextColor="#333333" PlaceholderColor="#999999"/>
                            <Button Grid.Column="1" Text="Add" Command="{Binding AddCategoryCommand}" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" HeightRequest="40" WidthRequest="60"/>
                        </Grid>
                    </Frame>
                    <Label Text="{Binding Categories.Count, StringFormat='Total Categories: {0}'}" FontSize="13" TextColor="#666666" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" SelectionMode="None" Margin="10,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Frame Margin="5,3" Padding="12" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding .}" FontSize="14" VerticalOptions="Center" TextColor="#333333"/>
                                    <Button Grid.Column="1" Text="✏️" BackgroundColor="#FF9800" TextColor="White"
                                            CornerRadius="5" HeightRequest="30" WidthRequest="40" Padding="0" FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StaffViewModel}}, Path=EditCategoryCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="2" Text="🗑️" BackgroundColor="#F44336" TextColor="White"
                                            CornerRadius="5" HeightRequest="30" WidthRequest="40" Padding="0" FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StaffViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                            <Label Text="🏷️" FontSize="50" HorizontalOptions="Center"/>
                            <Label Text="No categories yet" FontSize="16" TextColor="#999999" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!-- 5. Summary Content -->
            <Grid x:Name="SummaryContent" IsVisible="False">
                <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None" Margin="5,0">
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="15,10" Spacing="8">
                            <Label Text="Order Summary" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Frame Grid.Column="0" BackgroundColor="#E3F2FD" CornerRadius="10" Padding="15" HasShadow="True">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                                        <Label Text="📦" FontSize="30" HorizontalOptions="Center"/>
                                        <Label Text="{Binding Orders.Count, StringFormat='{0} Orders'}" FontSize="14" FontAttributes="Bold" TextColor="#1976D2" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame Grid.Column="1" BackgroundColor="#E8F5E9" CornerRadius="10" Padding="15" HasShadow="True">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                                        <Label Text="💰" FontSize="30" HorizontalOptions="Center"/>
                                        <Label Text="{Binding TotalRevenue, StringFormat='₱{0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                            <Label Text="All Orders" FontSize="16" FontAttributes="Bold" TextColor="#333333"/>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Frame Margin="5,3" Padding="12" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding OrderNumber}" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                                        <Label Text="{Binding OrderDate, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="#666666"/>
                                        <Label Text="{Binding PaymentMethod}" FontSize="11" TextColor="#999999"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₱{0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center"/>
                                    <Frame Grid.Column="2" CornerRadius="10" Padding="8,3" BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" HasShadow="False">
                                        <Label Text="{Binding Status}" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                            <Label Text="📊" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="No orders yet" FontSize="16" TextColor="#999999" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>