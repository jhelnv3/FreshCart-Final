<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FreshCart.ViewModels"
             xmlns:models="clr-namespace:FreshCart.Models"
             x:Class="FreshCart.Views.UserPage"
             Title="FreshCart - Products"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <viewmodels:UserViewModel/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- Header with Navigation -->
        <Grid Grid.Row="0" Padding="10,8" BackgroundColor="White" ColumnDefinitions="*,Auto">
            <ScrollView Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <!-- Cart Button with Count Inside -->
                    <Button Text="{Binding CartItemCount, StringFormat='🛒 Cart({0})'}" 
                            Command="{Binding GoToCartCommand}"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="12,0"/>
                    <Button Text="📊 Status" 
                            Command="{Binding GoToStatusCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="12,0"/>
                    <Button Text="📜 History" 
                            Command="{Binding GoToHistoryCommand}"
                            BackgroundColor="#9C27B0"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="12,0"/>
                </HorizontalStackLayout>
            </ScrollView>

            <Button Grid.Column="1" 
                    Text="🚪" 
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="38"
                    WidthRequest="50"
                    FontSize="16"
                    Padding="0"
                    Margin="5,0,0,0"/>
        </Grid>

        <!-- REMOVED: Cart Badge Frame -->

        <!-- Search Bar -->
        <Frame Grid.Row="1" 
               Margin="10,5" 
               Padding="0" 
               CornerRadius="10" 
               HasShadow="True" 
               BackgroundColor="White">
            <SearchBar Text="{Binding SearchQuery}"
                      Placeholder="🔍 Search products..."
                      SearchCommand="{Binding SearchCommand}"
                      TextColor="#333333"
                      PlaceholderColor="#999999"
                      BackgroundColor="Transparent"/>
        </Frame>

        <!-- Products List -->
        <CollectionView Grid.Row="2" 
                       ItemsSource="{Binding FilteredProducts}"
                       SelectionMode="None"
                       Margin="5,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProductDisplay">
                    <Frame Margin="5,4" Padding="12" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                        <VerticalStackLayout Spacing="8">

                            <!-- Product Info Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="#333333"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Price, StringFormat='₱{0:F2}'}" 
                                           FontSize="15" 
                                           TextColor="#4CAF50"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding StockQuantity, StringFormat='📦 Stock: {0}'}" 
                                           FontSize="11"
                                           TextColor="#666666"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Quantity Controls Row -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">

                                <!-- Minus Button -->
                                <Button Grid.Column="0" 
                                        Text="−" 
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="#FF5252"
                                        TextColor="White"
                                        CornerRadius="18"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UserViewModel}}, Path=DecreaseQuantityCommand}"
                                        CommandParameter="{Binding .}"/>

                                <!-- Quantity Display -->
                                <Frame Grid.Column="1" 
                                       BackgroundColor="#F5F5F5" 
                                       CornerRadius="8" 
                                       Padding="5"
                                       HasShadow="False"
                                       HeightRequest="36"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding SelectedQuantity}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="#333333"/>
                                </Frame>

                                <!-- Plus Button -->
                                <Button Grid.Column="2" 
                                        Text="+" 
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        CornerRadius="18"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UserViewModel}}, Path=IncreaseQuantityCommand}"
                                        CommandParameter="{Binding .}"/>

                                <!-- Add to Cart Button -->
                                <Button Grid.Column="3" 
                                        Text="Add to Cart" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UserViewModel}}, Path=AddToCartCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#2196F3"
                                        TextColor="White"
                                        CornerRadius="18"
                                        HeightRequest="36"
                                        FontSize="12"
                                        Padding="10,0"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                   HorizontalOptions="Center" 
                                   Padding="20">
                    <Label Text="🔍" 
                           FontSize="50" 
                           HorizontalOptions="Center"/>
                    <Label Text="No products found" 
                           FontSize="16" 
                           TextColor="#999999"
                           HorizontalOptions="Center"/>
                    <Label Text="Try a different search term" 
                           FontSize="13" 
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>