<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FreshCart.ViewModels"
             xmlns:models="clr-namespace:FreshCart.Models"
             x:Class="FreshCart.Views.HistoryPage"
             Title="Purchase History"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <viewmodels:HistoryViewModel/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F5F5F5">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="15" BackgroundColor="White">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Purchase History" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="#333333"/>
                <Label Text="{Binding Orders.Count, StringFormat='Total Orders: {0}'}" 
                       FontSize="13"
                       TextColor="#666666"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" 
                    Text="🚪" 
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="50"
                    FontSize="16"
                    Padding="0"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Orders List -->
        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding Orders}" 
                       SelectionMode="None"
                       Margin="5,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <Frame Margin="8,4" 
                           Padding="12" 
                           CornerRadius="10" 
                           HasShadow="True" 
                           BackgroundColor="White">
                        <VerticalStackLayout Spacing="8">

                            <!-- Order Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding OrderNumber, StringFormat='📦 Order {0}'}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="#333333"/>
                                    <Label Text="{Binding OrderDate, StringFormat='📅 {0:MMM dd, yyyy hh:mm tt}'}" 
                                           FontSize="11" 
                                           TextColor="#666666"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                                    <Label Text="{Binding TotalAmount, StringFormat='₱{0:F2}'}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#4CAF50"
                                           HorizontalTextAlignment="End"/>
                                    <Label Text="{Binding PaymentMethod}" 
                                           FontSize="11"
                                           TextColor="#666666"
                                           HorizontalTextAlignment="End"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Status Badge -->
                            <Frame CornerRadius="12" 
                                   Padding="8,4"
                                   BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                   HasShadow="False"
                                   HorizontalOptions="Start">
                                <Label Text="{Binding Status}" 
                                       TextColor="White" 
                                       FontAttributes="Bold"
                                       FontSize="11"/>
                            </Frame>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" Color="#E0E0E0"/>

                            <!-- Items List -->
                            <Label Text="📋 Items Purchased:" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   TextColor="#333333"/>

                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="8" 
                                   Padding="8" 
                                   HasShadow="False">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" 
                                                   Spacing="5">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CartItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" 
                                                  ColumnSpacing="8">
                                                <Label Grid.Column="0" 
                                                       Text="•" 
                                                       FontSize="14"
                                                       VerticalOptions="Center"
                                                       TextColor="#666666"/>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding Product.Name}" 
                                                       FontSize="13"
                                                       VerticalOptions="Center"
                                                       TextColor="#333333"/>
                                                <Frame Grid.Column="2" 
                                                       BackgroundColor="#E3F2FD" 
                                                       CornerRadius="3" 
                                                       Padding="5,2"
                                                       HasShadow="False">
                                                    <Label Text="{Binding Quantity, StringFormat='x{0}'}" 
                                                           FontSize="11"
                                                           TextColor="#1976D2"
                                                           FontAttributes="Bold"/>
                                                </Frame>
                                                <Label Grid.Column="3" 
                                                       Text="{Binding TotalPrice, StringFormat='₱{0:F2}'}" 
                                                       FontSize="13"
                                                       TextColor="#4CAF50"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Frame>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                   HorizontalOptions="Center" 
                                   Padding="20">
                    <Label Text="📭" 
                           FontSize="50" 
                           HorizontalOptions="Center"/>
                    <Label Text="No purchase history yet" 
                           FontSize="16" 
                           TextColor="#999999"
                           HorizontalOptions="Center"/>
                    <Label Text="Start shopping to see your orders here!" 
                           FontSize="13" 
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>