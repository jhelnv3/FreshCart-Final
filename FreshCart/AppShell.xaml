<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FreshCart.Views"
       x:Class="FreshCart.AppShell"
       FlyoutBehavior="Disabled">

    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent Route="UserPage" ContentTemplate="{DataTemplate views:UserPage}" />
    <ShellContent Route="CartPage" ContentTemplate="{DataTemplate views:CartPage}" />
    <ShellContent Route="StatusPage" ContentTemplate="{DataTemplate views:StatusPage}" />
    <ShellContent Route="HistoryPage" ContentTemplate="{DataTemplate views:HistoryPage}" />

    <ShellContent Route="StaffPage" ContentTemplate="{DataTemplate views:StaffPage}" />

</Shell>